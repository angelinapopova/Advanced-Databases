CREATE OR REPLACE VIEW vw_customer_risk_profile AS
SELECT
    c.customer_id,
    c.first_name || ' ' || c.last_name          AS full_name,
    c.country_code,
    c.is_active,
    COUNT(t.transaction_id)                      AS total_transactions,
    COUNT(t.transaction_id)
        FILTER (WHERE t.status = 'APPROVED')     AS approved_count,
    COUNT(t.transaction_id)
        FILTER (WHERE t.status = 'FLAGGED')      AS flagged_count,
    COUNT(t.transaction_id)
        FILTER (WHERE t.status = 'DECLINED')     AS declined_count,
    COALESCE(ROUND(AVG(t.risk_score), 2), 0)    AS avg_risk_score,
    COALESCE(MAX(t.risk_score), 0)               AS max_risk_score,
    COALESCE(SUM(t.amount)
        FILTER (WHERE t.status = 'APPROVED'), 0) AS total_approved_amount,
    COUNT(fa.alert_id)                           AS total_alerts,
    COUNT(fa.alert_id)
        FILTER (WHERE fa.alert_status = 'OPEN')  AS open_alerts,
    CASE
        WHEN MAX(t.risk_score) >= 80 THEN 'CRITICAL'
        WHEN MAX(t.risk_score) >= 60 THEN 'HIGH'
        WHEN MAX(t.risk_score) >= 40 THEN 'MEDIUM'
        ELSE 'LOW'
    END                                          AS risk_level
FROM customers c
LEFT JOIN accounts a     ON a.customer_id    = c.customer_id
LEFT JOIN transactions t ON t.account_id     = a.account_id
LEFT JOIN fraud_alerts fa ON fa.transaction_id = t.transaction_id
GROUP BY c.customer_id, c.first_name, c.last_name, c.country_code, c.is_active
ORDER BY max_risk_score DESC, total_alerts DESC;

