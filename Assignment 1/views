SELECT * FROM vw_recent_transactions WHERE risk_level = 'CRITICAL';


CREATE OR REPLACE VIEW vw_flagged_transactions AS
SELECT
    t.transaction_id,
    c.customer_id,
    c.first_name || ' ' || c.last_name  AS customer_name,
    c.country_code                       AS customer_country,
    a.account_number,
    t.amount,
    t.currency,
    t.merchant_category,
    t.merchant_country,
    t.status,
    t.risk_score,
    t.transaction_at,
    fa.alert_id,
    fa.reason                            AS alert_reason,
    fa.alert_status,
    fr.rule_name,
    fr.rule_type,
    fa.created_at                        AS alert_created_at
FROM transactions t
JOIN accounts a     ON a.account_id     = t.account_id
JOIN customers c    ON c.customer_id    = a.customer_id
LEFT JOIN fraud_alerts fa ON fa.transaction_id = t.transaction_id
LEFT JOIN fraud_rules fr  ON fr.rule_id        = fa.rule_id
WHERE t.status IN ('FLAGGED', 'DECLINED')
ORDER BY t.risk_score DESC, t.transaction_at DESC;

