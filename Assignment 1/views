CREATE OR REPLACE VIEW vw_customer_accounts AS
SELECT
    c.customer_id,
    c.first_name || ' ' || c.last_name  AS full_name,
    c.email,
    c.country_code,
    c.is_active                          AS customer_active,
    a.account_id,
    a.account_number,
    a.currency,
    a.balance,
    a.status                             AS account_status,
    a.opened_at,
    COUNT(cd.card_id)                    AS total_cards,
    COUNT(cd.card_id) FILTER (WHERE cd.status = 'ACTIVE') AS active_cards
FROM customers c
JOIN accounts a   ON a.customer_id = c.customer_id
LEFT JOIN cards cd ON cd.account_id = a.account_id
GROUP BY
    c.customer_id, c.first_name, c.last_name,
    c.email, c.country_code, c.is_active,
    a.account_id, a.account_number, a.currency,
    a.balance, a.status, a.opened_at;

