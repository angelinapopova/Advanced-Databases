CREATE OR REPLACE VIEW vw_recent_transactions AS
SELECT
    t.transaction_id,
    c.customer_id,
    c.first_name || ' ' || c.last_name  AS customer_name,
    a.account_number,
    t.amount,
    t.currency,
    t.merchant_category,
    t.merchant_country,
    t.status,
    t.risk_score,
    t.transaction_at,
    CASE
        WHEN t.risk_score >= 70 THEN 'CRITICAL'
        WHEN t.risk_score >= 40 THEN 'HIGH'
        WHEN t.risk_score >= 20 THEN 'MEDIUM'
        ELSE 'LOW'
    END                                  AS risk_level
FROM transactions t
JOIN accounts a  ON a.account_id  = t.account_id
JOIN customers c ON c.customer_id = a.customer_id
WHERE t.transaction_at >= NOW() - INTERVAL '30 days'
ORDER BY t.transaction_at DESC;

