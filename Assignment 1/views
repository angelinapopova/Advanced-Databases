CREATE MATERIALIZED VIEW mv_daily_fraud_summary AS
WITH daily_top_customers AS (
    SELECT
        DATE(t.transaction_at)  AS tx_date,
        a.customer_id,
        MAX(t.risk_score)       AS max_score,
        ROW_NUMBER() OVER (
            PARTITION BY DATE(t.transaction_at)
            ORDER BY MAX(t.risk_score) DESC
        )                       AS rnk
    FROM transactions t
    JOIN accounts a ON a.account_id = t.account_id
    GROUP BY DATE(t.transaction_at), a.customer_id
),
top3 AS (
    SELECT
        tx_date,
        STRING_AGG(customer_id::TEXT, ', ' ORDER BY rnk) AS top_risky_customers
    FROM daily_top_customers
    WHERE rnk <= 3
    GROUP BY tx_date
)
SELECT
    DATE(t.transaction_at)                           AS transaction_date,
    COUNT(t.transaction_id)                          AS total_transactions,
    ROUND(SUM(t.amount), 2)                          AS total_amount,
    COUNT(t.transaction_id)
        FILTER (WHERE t.status IN ('FLAGGED', 'DECLINED')) AS flagged_count,
    ROUND(COALESCE(SUM(t.amount)
        FILTER (WHERE t.status IN ('FLAGGED', 'DECLINED')), 0), 2) AS suspicious_amount,
    ROUND(AVG(t.risk_score), 2)                      AS avg_risk_score,
    top3.top_risky_customers,
    COUNT(fa.alert_id)                               AS total_fraud_alerts
FROM transactions t
LEFT JOIN fraud_alerts fa ON fa.transaction_id = t.transaction_id
LEFT JOIN top3            ON top3.tx_date = DATE(t.transaction_at)
GROUP BY DATE(t.transaction_at), top3.top_risky_customers
ORDER BY transaction_date DESC;



-- Індекс на дату для швидкого пошуку по конкретному дню
CREATE UNIQUE INDEX idx_mv_daily_fraud_summary_date
    ON mv_daily_fraud_summary (transaction_date);



REFRESH MATERIALIZED VIEW CONCURRENTLY mv_daily_fraud_summary;
