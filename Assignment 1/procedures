CALL process_transaction(44);



CREATE OR REPLACE PROCEDURE freeze_account(p_account_id BIGINT)
LANGUAGE plpgsql
AS $$
DECLARE
    v_account      accounts%ROWTYPE;
    v_customer_id  BIGINT;
BEGIN

    SELECT * INTO v_account
    FROM accounts
    WHERE account_id = p_account_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Account % not found', p_account_id;
    END IF;

    IF v_account.status = 'FROZEN' THEN
        RAISE NOTICE 'Account % is already frozen', p_account_id;
        RETURN;
    END IF;

    IF v_account.status = 'CLOSED' THEN
        RAISE EXCEPTION 'Cannot freeze closed account %', p_account_id;
    END IF;


    UPDATE accounts
    SET status = 'FROZEN'
    WHERE account_id = p_account_id;


    UPDATE cards
    SET status = 'BLOCKED'
    WHERE account_id = p_account_id
      AND status = 'ACTIVE';


    SELECT customer_id INTO v_customer_id
    FROM accounts WHERE account_id = p_account_id;

    INSERT INTO audit_log (customer_id, table_name, operation, old_value, new_value)
    VALUES (
        v_customer_id,
        'accounts',
        'UPDATE',
        jsonb_build_object('account_id', p_account_id, 'status', v_account.status),
        jsonb_build_object('account_id', p_account_id, 'status', 'FROZEN')
    );

    RAISE NOTICE 'Account % frozen, all active cards blocked', p_account_id;
END;
$$;

-- Тест:
CALL freeze_account(3);



CREATE OR REPLACE PROCEDURE approve_pending_transactions(
    p_older_than_minutes INT DEFAULT 10
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_transaction_id  BIGINT;
    v_processed       INT := 0;
    v_cutoff_time     TIMESTAMP;
BEGIN
    v_cutoff_time := NOW() - (p_older_than_minutes || ' minutes')::INTERVAL;


    FOR v_transaction_id IN
        SELECT transaction_id
        FROM transactions
        WHERE status = 'PENDING'
          AND created_at <= v_cutoff_time
        ORDER BY created_at ASC
    LOOP
        CALL process_transaction(v_transaction_id);
        v_processed := v_processed + 1;
    END LOOP;

    RAISE NOTICE 'Processed % pending transactions older than % minutes',
        v_processed, p_older_than_minutes;
END;
$$;

-- Тест:
CALL approve_pending_transactions();
CALL approve_pending_transactions(1);

CREATE OR REPLACE PROCEDURE refresh_fraud_dashboard()
LANGUAGE plpgsql
AS $$
BEGIN
    RAISE NOTICE 'Refreshing fraud dashboard at %', NOW();

    REFRESH MATERIALIZED VIEW mv_daily_fraud_summary;


    INSERT INTO audit_log (table_name, operation, new_value)
    VALUES (
        'mv_daily_fraud_summary',
        'UPDATE',
        jsonb_build_object('refreshed_at', NOW())
    );

    RAISE NOTICE 'Fraud dashboard refreshed successfully';
END;
$$;

-- Тест:
CALL refresh_fraud_dashboard();
