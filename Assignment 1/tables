-- All transactions start as PENDING → then move to their current status
INSERT INTO transaction_status_history (transaction_id, old_status, new_status, changed_at, changed_by)
SELECT
    t.transaction_id,
    NULL,
    'PENDING',
    t.transaction_at,
    'system'
FROM transactions t;

INSERT INTO transaction_status_history (transaction_id, old_status, new_status, changed_at, changed_by)
SELECT
    t.transaction_id,
    'PENDING',
    t.status,
    t.transaction_at + INTERVAL '1 minute',
    CASE
        WHEN t.status = 'APPROVED'  THEN 'auto_approve'
        WHEN t.status = 'DECLINED'  THEN 'fraud_engine'
        WHEN t.status = 'FLAGGED'   THEN 'fraud_engine'
        ELSE 'system'
    END
FROM transactions t
WHERE t.status != 'PENDING';


INSERT INTO fraud_alerts (transaction_id, rule_id, reason, risk_score, alert_status, created_at)
SELECT
    t.transaction_id,
    CASE
        WHEN t.amount >= 50000                                 THEN 1  -- Large Single Transaction
        WHEN t.merchant_category IN ('GAMBLING','CASINO')      THEN 8  -- Gambling Merchant
        WHEN t.merchant_country IN ('RU','KP','IR','NG')       THEN 3  -- High Risk Country
        WHEN t.merchant_category IN ('CRYPTO','WIRE_TRANSFER') THEN 6  -- Cross-Currency
        ELSE 4                                                          -- Multiple Transactions
    END AS rule_id,
    CASE
        WHEN t.amount >= 50000                                 THEN 'Transaction amount exceeds large transaction threshold'
        WHEN t.merchant_category IN ('GAMBLING','CASINO')      THEN 'Gambling or casino merchant detected'
        WHEN t.merchant_country IN ('RU','KP','IR','NG')       THEN 'Transaction to high-risk country'
        WHEN t.merchant_category IN ('CRYPTO','WIRE_TRANSFER') THEN 'Crypto or wire transfer to suspicious destination'
        ELSE 'High transaction velocity detected in short time window'
    END AS reason,
    t.risk_score,
    CASE
        WHEN t.risk_score >= 90 THEN 'CLOSED'       -- already acted on
        WHEN t.risk_score >= 70 THEN 'REVIEWED'
        ELSE 'OPEN'
    END AS alert_status,
    t.transaction_at + INTERVAL '2 minutes'
FROM transactions t
WHERE t.status IN ('FLAGGED', 'DECLINED');


